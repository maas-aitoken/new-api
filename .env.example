# 端口号
# PORT=3000
# 前端基础URL
# FRONTEND_BASE_URL=https://your-frontend-url.com


# 调试相关配置
# 启用pprof
# ENABLE_PPROF=true
# 启用调试模式
# DEBUG=true
# 默认语言：日志输出，以及对方没有指定语言时返回的提示、邮件和通知。可选 en、zh-CN、zh-TW，不设置为 en
# DEFAULT_LANGUAGE=zh-CN
# Pyroscope 配置
# PYROSCOPE_URL=http://localhost:4040
# PYROSCOPE_APP_NAME=new-api
# PYROSCOPE_BASIC_AUTH_USER=your-user
# PYROSCOPE_BASIC_AUTH_PASSWORD=your-password
# PYROSCOPE_MUTEX_RATE=5
# PYROSCOPE_BLOCK_RATE=5
# HOSTNAME=your-hostname

# 数据库相关配置
# 启用错误日志记录
# ERROR_LOG_ENABLED=true
# 数据库连接字符串
# SQL_DSN=user:password@tcp(127.0.0.1:3306)/dbname?parseTime=true
# 日志数据库连接字符串
# LOG_SQL_DSN=user:password@tcp(127.0.0.1:3306)/logdb?parseTime=true
# ClickHouse 日志库的表 TTL（天），对 logs、relay_attempts、capability_gate_events 三张表生效
# 0 或不设置表示不过期，并会移除这些表上已有的 TTL；非 ClickHouse 日志库不读取此项
# LOG_SQL_CLICKHOUSE_TTL_DAYS=30
# Consul 初始配置：启动时按下面两个路径各发一次 GET，先读 config，再读日志库；两个路径都可选
#   CONSUL_KV_CONFIG_PATH  扁平 JSON，键名同环境变量名，如 {"SQL_DSN":"...","RELAY_TIMEOUT":60,"CONSUL_CLICKHOUSE_CONFIG_KEY":"cht_maas_log"}
#                          值优先于环境变量；值为 ""、0、false、null 或键不存在时使用环境变量；要覆盖为 0/false 请写字符串 "0"/"false"
#                          读取失败只记日志，保留环境变量，不影响读取日志库
#   CONSUL_KV_DB_PATH      日志库配置 JSON，从 clickhouse.<配置名> 读取 database/host/password/port/user
#                          读取失败回退 LOG_SQL_DSN，LOG_SQL_DSN 也为空时启动报错
# 以下四项只能来自环境变量
# CONSUL_HTTP_ADDR=consul.example.com:8500  # 省略 scheme 时默认 http://
# CONSUL_HTTP_TOKEN=
# CONSUL_KV_CONFIG_PATH=app/new-api/config
# CONSUL_KV_DB_PATH=database/autom/maas/clickhouse/maas_logs
# 指定 clickhouse 下的配置名，CONSUL_KV_CONFIG_PATH 的 JSON 里可覆盖；指定但不存在时回退 LOG_SQL_DSN
# CONSUL_CLICKHOUSE_CONFIG_KEY=
# SQLite数据库路径
# SQLITE_PATH=/path/to/sqlite.db
# 数据库最大空闲连接数
# SQL_MAX_IDLE_CONNS=100
# 数据库最大打开连接数
# SQL_MAX_OPEN_CONNS=1000
# 数据库连接最大生命周期（秒）
# SQL_MAX_LIFETIME=60
# 慢查询日志阈值（毫秒），0 表示关闭慢查询日志，超出 0-3600000 范围回退默认值 200
# SQL_SLOW_THRESHOLD_MS=200
# 跳过用户额度列 64 位 schema 检查（仅在已确认数据库列可容纳 64 位时启用）
# SKIP_64BIT_QUOTA_SCHEMA_CHECK=true

# 请求尝试遥测（relay_attempts）：每次对上游渠道的尝试记录一行，作为路由与成功率模型的训练数据
# 写入日志库（LOG_SQL_DSN 为空时与主库同库），由异步 writer 批量落库；缓冲写满时丢弃并计数，不会阻塞转发
# 是否启用，默认 false
# RELAY_ATTEMPT_LOG_ENABLED=true
# 采样率，范围 0-1，默认 1（全量）；超出范围按 0 或 1 截断，无法解析时回退为 1
# RELAY_ATTEMPT_LOG_SAMPLE_RATE=1
# 异步队列容量，默认 4096，最小 1
# RELAY_ATTEMPT_LOG_BUFFER_SIZE=4096
# 每批写入条数，默认 200，最小 1，且不会超过队列容量
# RELAY_ATTEMPT_LOG_BATCH_SIZE=200
# 批量写入的最长等待时间（毫秒），默认 2000，最小 100
# RELAY_ATTEMPT_LOG_FLUSH_MS=2000


# 缓存相关配置
# Redis连接字符串
# REDIS_CONN_STRING=redis://user:password@localhost:6379/0
# 同步频率（单位：秒）
# SYNC_FREQUENCY=60
# 内存缓存启用
# MEMORY_CACHE_ENABLED=true
# 渠道更新频率（单位：秒）
# CHANNEL_UPDATE_FREQUENCY=30
# 批量更新启用
# BATCH_UPDATE_ENABLED=true
# 批量更新间隔（单位：秒）
# BATCH_UPDATE_INTERVAL=5

# 任务和功能配置
# 更新任务启用
# UPDATE_TASK=true
# 异步任务硬超时（分钟），按提交时间计算，超时未完成的任务标记失败并退款；0 表示禁用
# TASK_TIMEOUT_MINUTES=1440
# 异步任务连续轮询失败阈值（上游 429/5xx/401/403、网络错误、无法识别的响应），达到后任务标记失败并退款；正常轮询成功一次即归零
# TASK_POLL_MAX_FAILURES=20

# 对话超时设置
# 所有请求超时时间，单位秒，默认为0，表示不限制
# RELAY_TIMEOUT=0
# Relay HTTP 客户端空闲连接超时时间，单位秒，默认跟随 Go 标准库，设置为0表示不限制
# RELAY_IDLE_CONN_TIMEOUT=90
# 等待上游返回响应头的超时时间，单位秒，默认 1800，设置为 0 表示不限制。
# 仅约束「等待响应头」这一段；响应头返回之后的流式传输不受影响。
# 注意：非流式请求通常要等上游生成完毕才会返回响应头，因此该值需留足余量。
# RELAY_RESPONSE_HEADER_TIMEOUT=1800
# 流模式无响应超时时间，单位秒，如果出现空补全可以尝试改为更大值
# STREAMING_TIMEOUT=300

# OpenTelemetry + Langfuse（默认关闭；追踪数据旁路导出，不影响模型响应）
# NEW_API_OTEL_ENABLED=false
# LANGFUSE_BASE_URL=http://langfuse:3000
# LANGFUSE_HOST=http://langfuse:3000  # backwards-compatible alias
# LANGFUSE_PROJECT_ID=your-project-id
# LANGFUSE_PUBLIC_KEY=pk-xxxx
# LANGFUSE_SECRET_KEY=sk-xxxx
# NEW_API_OTEL_CAPTURE_MODE=error  # full, error, or off
# NEW_API_OTEL_CAPTURE_MAX_BYTES=4194304
# 可选：使用自定义 OTLP/HTTP 端点（优先于 LANGFUSE_BASE_URL）
# OTEL_EXPORTER_OTLP_ENDPOINT=http://collector:4318
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Bearer%20token

# TLS / HTTP 跳过验证设置
# TLS_INSECURE_SKIP_VERIFY=false

# Gin 可信反向代理（逗号分隔的 IP/CIDR）
# 未配置/留空：默认信任 127.0.0.0/8、::1、RFC1918 私网和 fc00::/7，并打印启动告警。
# none：严格模式，不信任任何代理且必须单独使用；显式列表完全替代默认值，应填写代理自身地址。
# TRUSTED_PROXIES=none
# TRUSTED_PROXIES=127.0.0.1,172.20.0.0/16

# Gemini 识别图片 最大图片数量
# GEMINI_VISION_MAX_IMAGE_NUM=16

# 会话密钥
# SESSION_SECRET=random_string
# 登录密码请求体 RSA-OAEP 加密；默认关闭，且不能替代 HTTPS
# PASSWORD_LOGIN_ENCRYPTION_ENABLED=true

# Account password storage. For a rolling upgrade, deploy every node with bcrypt
# first (dual-format verification), then switch all nodes to argon2id before
# enabling long passwords. A rollback must retain Argon2id verification and
# v2 login-password envelope support (when login encryption is enabled).
# Existing bcrypt hashes and MFA backup codes are not rewritten.
# ACCOUNT_PASSWORD_HASH_ALGORITHM=argon2id
# false/未配置：本地 HTTP 模式，关闭 refresh/logout OriginGuard，且不得设置 TRUSTED_URL；兼容本地开发代理。
# true：启用 Secure Refresh Cookie 和严格 OriginGuard，必须同时列出全部可信 HTTPS Origin。
# SESSION_COOKIE_TRUSTED_URL 多项用英文逗号分隔；不支持通配符、路径或域名后缀匹配。
# 这些设置不修改 relay CORS。
# SESSION_COOKIE_SECURE=false
# SESSION_COOKIE_TRUSTED_URL=https://example.com,https://admin.example.com
# 每用户最多保留的活跃登录 Session
# USER_SESSION_ACTIVE_LIMIT=50
# 单用户在签发窗口内允许创建的 Session 总数（包含已撤销）
# USER_SESSION_ISSUANCE_LIMIT=100
# Session 签发计数窗口（秒）；不得大于 revoked 保留期，超出时会自动钳制
# USER_SESSION_ISSUANCE_WINDOW_SECONDS=86400
# revoked Session 审计保留天数
# USER_SESSION_REVOKED_RETENTION_DAYS=7
# 最近一小时全局 Session 签发量超过此值时记录告警，不会拒绝登录
# USER_SESSION_HOURLY_ALERT_THRESHOLD=5000

# 其他配置
# 生成默认token
# GENERATE_DEFAULT_TOKEN=false
# Cohere 安全设置
# COHERE_SAFETY_SETTING=NONE
# 是否统计图片token
# GET_MEDIA_TOKEN=true
# 是否在非流（stream=false）情况下统计图片token
# GET_MEDIA_TOKEN_NOT_STREAM=false
# 设置 Dify 渠道是否输出工作流和节点信息到客户端
# DIFY_DEBUG=true

# auto 模型路由的 jev 判断端点；未配置时不调用 jev，直接使用默认模型
# 以下六个变量只是兜底：系统设置 → Auto 路由里填了的值优先，没填的才读环境变量
# JEV_ENDPOINT=https://openrouter.ai/api/alpha/decisions
# JEV_API_KEY=
# OpenRouter 必填，自部署端点忽略
# JEV_MODEL=typesafe/jev-1.13
# 榜单刷新用的三个 key：Artificial Analysis 必填，Design Arena 与 OpenRouter 至少一个
# ARTIFICIAL_ANALYSIS_API_KEY=
# DESIGN_ARENA_API_KEY=
# OPENROUTER_API_KEY=

# LinuxDo相关配置
LINUX_DO_TOKEN_ENDPOINT=https://connect.linux.do/oauth2/token
LINUX_DO_USER_ENDPOINT=https://connect.linux.do/api/user

# 节点类型
# 如果是主节点则为master
# NODE_TYPE=master

# 可信任重定向域名列表（逗号分隔，支持子域名匹配）
# 用于验证支付成功/取消回调URL的域名安全性
# 示例: example.com,myapp.io 将允许 example.com, sub.example.com, myapp.io 等
# TRUSTED_REDIRECT_DOMAINS=example.com,myapp.io

# 能力门控的模式（off / shadow / enforce）、请求体上限、维度策略、事件保留期都存在数据库里，
# 在「系统设置 → 模型 → Capability Gate」中配置；已不再读取 AUTO_CAPABILITY_GATE_MODE 和
# AUTO_CAPABILITY_GATE_MAX_BODY_BYTES 这两个环境变量。
# 门控事件（capability_gate_events）由异步 writer 批量写入日志库，下面四项只调这个 writer 和清理任务，
# 修改后需重启生效；超出范围的值会被截断，无法解析时回退默认值
# 异步队列容量，默认 4096，范围 1-1000000；写满时丢弃并计数，不会阻塞选路
# CAPABILITY_GATE_EVENT_BUFFER_SIZE=4096
# 每批写入条数，默认 200，范围 1-10000，且不超过队列容量
# CAPABILITY_GATE_EVENT_BATCH_SIZE=200
# 批量写入的最长等待时间（毫秒），默认 2000，范围 100-3600000
# CAPABILITY_GATE_EVENT_FLUSH_MS=2000
# 清理过期事件时每块删除的行数，默认 1000，范围 1-10000；块越小单次持锁越短，块越大清理越快
# ClickHouse 日志库靠表 TTL 过期，不受此项影响
# CAPABILITY_GATE_EVENT_CLEANUP_CHUNK=1000

# auto 请求的选路日志（auto_route_logs）记哪些请求、保留几天，在「系统设置 → Auto 路由 → 选路日志」中配置，
# 存在数据库里。日志由异步 writer 批量写入日志库，下面四项只调这个 writer 和清理任务，
# 修改后需重启生效；超出范围的值会被截断，无法解析时回退默认值
# 异步队列容量，默认 4096，范围 1-1000000；写满时丢弃并计数，不会阻塞选路
# AUTO_ROUTE_LOG_BUFFER_SIZE=4096
# 每批写入条数，默认 200，范围 1-10000，且不超过队列容量
# AUTO_ROUTE_LOG_BATCH_SIZE=200
# 批量写入的最长等待时间（毫秒），默认 2000，范围 100-3600000
# AUTO_ROUTE_LOG_FLUSH_MS=2000
# 清理过期日志时每块删除的行数，默认 1000，范围 1-10000
# ClickHouse 日志库靠表 TTL（LOG_SQL_CLICKHOUSE_TTL_DAYS）过期，不受此项和保留天数影响
# AUTO_ROUTE_LOG_CLEANUP_CHUNK=1000

# 资源池页「容量池」的动态额度由主节点定时拉上游账号池、按可用账号数与余量重算，
# 写进 Redis 给调度器读。下面是重算间隔（秒），默认 60，最小 15；修改后需重启生效
# CAPACITY_POOL_POLL_SECONDS=60

# HOIDC SSO configuration
# HOIDC_ENABLED=false
# HOIDC_LOGIN_PAGE=https://sso.example.com/login
# HOIDC_SSO_API=https://sso.example.com/api
# HOIDC_PLATFORM_ID=your-platform-id
# HOIDC_ALLOW_SIGNUP=false
# HOIDC_ENFORCE_SSO=false

# SSO user sync configuration
# SSO_SYNC_ENABLED=false
# SSO_USER_LIST_API_URL=https://sso.example.com/api
# SSO_USER_LIST_PLATFORM_ID=your-platform-id
# SSO_USER_LIST_SECRET=your-secret

# 提额通知：提额成功后向 cloud 平台 POST {"email","message"}，cloud 按邮箱发给 TL 和部门负责人；URL 留空不发送
# 请求头为 JSON 对象；message 语言跟随 DEFAULT_LANGUAGE；发送失败只记日志，不影响提额
# QUOTA_INCREASE_NOTIFY_URL=https://cloud.example.com/api/v1/quota/notify
# QUOTA_INCREASE_NOTIFY_HEADERS='{"platId":"your-plat-id"}'
